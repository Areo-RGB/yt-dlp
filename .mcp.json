{
  "mcpServers": {
    "vue-mcp": {
      "url": "http://localhost:15688/__mcp",
      "serverUrl": "http://localhost:15688/__mcp"
    },
    "tauri": {
      "command": "./scripts/mcp-tauri-server.sh"
    },
    "serena-index": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "-p",
        "3.13",
        "--from",
        "git+https://github.com/Areo-RGB/serena-main",
        "serena",
        "start-mcp-server",
        "--context=vscode",
        "--language-backend",
        "LSP",
        "--open-web-dashboard=false"
      ]
    }
  }
}
